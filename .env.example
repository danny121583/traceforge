# TraceForge Local Server Environment Template
# Copy this file to `.env` (which is gitignored) and supply your own Meta Model API key
# ONLY when authorized by the Project Owner for live runtime inference testing.
#
# SECURITY WARNING:
# - Never prefix this variable with `VITE_`! Variables prefixed with `VITE_` are statically
#   embedded into the client-side browser bundle by Vite.
# - `META_API_KEY` must ONLY be read by the local server/proxy (never in browser code).
# - Do not copy or extract credentials from the Muse Code CLI (`muse login`).

META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
